# =================================================================
# Core Services Environment Configuration
# =================================================================
# Used by `coreservices-homelab` only (Traefik, Vault, backup/restore scripts).
# Copy to `.env` if needed, then run `./scripts/setup.sh` and `./scripts/start.sh`.

# =================================================================
# GENERAL
# =================================================================
TIMEZONE="America/Chicago"

# =================================================================
# AUTHENTICATION / KEYCLOAK
# =================================================================
# Authentication PostgreSQL Database
AUTH_POSTGRES_USER="pgcore"
AUTH_POSTGRES_PASSWORD="$(openssl rand -hex 24)"
AUTH_POSTGRES_CPU_LIMIT="1.0"
AUTH_POSTGRES_MEMORY_LIMIT="1G"
AUTH_POSTGRES_CPU_RESERVATION="0.25"
AUTH_POSTGRES_MEMORY_RESERVATION="256M"

# Keycloak Database Credentials (used in init-db.sql)
KEYCLOAK_DB_PASSWORD="$(openssl rand -hex 24)"
AUTH_MONITOR_PASSWORD="$(openssl rand -hex 24)"

# Keycloak Admin Credentials
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="$(openssl rand -hex 24)"

# Keycloak Resource Limits
KEYCLOAK_CPU_LIMIT="2.0"
KEYCLOAK_MEMORY_LIMIT="2G"
KEYCLOAK_CPU_RESERVATION="0.5"
KEYCLOAK_MEMORY_RESERVATION="512M"

# Keycloak Client Secrets (generated after realm setup)
# Run ./scripts/start.sh - realm init runs automatically and prints these values
KEYCLOAK_OPENWEBUI_CLIENT_SECRET=""
KEYCLOAK_N8N_CLIENT_SECRET=""
KEYCLOAK_LITELLM_CLIENT_SECRET=""
KEYCLOAK_GRAFANA_CLIENT_SECRET=""
KEYCLOAK_VAULT_CLIENT_SECRET=""
KEYCLOAK_TRAEFIK_CLIENT_SECRET=""

# Traefik ForwardAuth Secret
TRAEFIK_FORWARD_AUTH_SECRET="$(openssl rand -hex 32)"

# =================================================================
# GRAFANA
# =================================================================
GRAFANA_ROOT_URL="https://grafana.local"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="$(openssl rand -hex 24)"

# =================================================================
# VAULT
# =================================================================
# Used by CLI and scripts for convenience.
VAULT_ADDR="http://127.0.0.1:8200"

# =================================================================
# BACKUP / RESTORE
# =================================================================
BACKUP_LOCATION="$HOME/coreservices-backups"

# =================================================================
# SIGNAL CLI (Optional)
# =================================================================
# Signal phone number for registration/authentication
SINGAL_NUMBER=""

# Signal captcha token (if required during registration)
SINGAL_CAPCHA=""

# Signal captcha token value
SINGAL_CAPCHA_TOKEN=""

# Signal captcha URL
SINGAL_CAPCHA_URL=""


